FROM python:3.11-slim

WORKDIR /app

# system deps for psycopg / polars are covered by wheels; keep image lean
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
# ponytail: seed CSV is gitignored and optional (main.py skips if absent; prod SEED_ON_START=0)
COPY schema.sql ./

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
